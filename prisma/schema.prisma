generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Student {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  age        Int
  department String
  image      String?
  createdAt  DateTime @default(now())
}
